BRIDGE_API_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
DOCKER_ID=your-docker-id
DOCKER_PAT=replace-with-cloud-sandboxes-enabled-pat
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
PROJECTS_FILE=./projects.json
# Or keep the allowlist out of the source tree (remove PROJECTS_FILE above; setting both is refused):
# PROJECTS_JSON={"my-app":{"repo":"https://github.com/example/my-app.git","tasks":{"test":"npm test"}}}
MOCK_DOCKER=0
# Required for real builds (refused without it): operator-only budget guard, see README "Budget guard".
# Amounts are integer micro-USD; these numbers are placeholders, not Docker prices. Then run:
#   node scripts/budget-admin.mjs init --authorized-by <you>
# BUDGET_JSON={"version":1,"policyVersion":1,"currency":"USD","smallHourlyRateMicroUsd":500000,"monthlyAllowanceMicroUsd":10000000,"projects":{},"opening":{"2026-11":{"globalMicroUsd":0}},"maxSetupSeconds":300,"ttlSeconds":3600,"evidence":{"rateVerified":false,"lifetimeVerified":false,"setupVerified":false}}

# Optional. Variables referenced from projects.json (names are examples; values are placeholders):
# GH_CLONE_TOKEN=replace-with-read-only-repo-token
# GH_STATUS_TOKEN=replace-with-commit-status-write-token
# NPM_TOKEN=replace-with-token-you-want-tasks-to-forward
# CI_HOOK_SECRET=replace-with-webhook-hmac-secret
# Repo hosts allowed in projects.json (replaces the default list):
# ALLOWED_GIT_HOSTS=github.com,gitlab.com
# Artifact export caps (bytes / counts):
# ARTIFACT_MAX_FILES=20
# ARTIFACT_MAX_FILE_BYTES=5242880
# ARTIFACT_MAX_TOTAL_BYTES=20971520
# ARTIFACT_INLINE_MAX_BYTES=262144
